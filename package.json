{
  "name": "prop-window",
  "version": "0.3.1",
  "private": true,
  "description": "A film prop window — real Chromium (Electron) whose address bar shows any URL you set, fully decoupled from the page it loads.",
  "type": "module",
  "main": "electron/main.js",
  "author": "Albert Hui <albert.hui@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SecurityRonin/prop-window",
  "repository": {
    "type": "git",
    "url": "https://github.com/SecurityRonin/prop-window.git"
  },
  "bugs": {
    "url": "https://github.com/SecurityRonin/prop-window/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "electron-builder",
    "mac:trust": "xattr -dr com.apple.quarantine node_modules/electron/dist/Electron.app && codesign --force --deep --sign - node_modules/electron/dist/Electron.app"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@31.7.7": true
  }
}
